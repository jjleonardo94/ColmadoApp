# Configuración General
SECRET_KEY=cambiar-por-una-clave-secreta-segura-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de Datos PostgreSQL (pgAdmin 4 compatible)
DB_NAME=colmadopos_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña_postgres
