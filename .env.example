# Configuración Regional (República Dominicana)
TIME_ZONE=America/Santo_Domingo
LANGUAGE_CODE=es-do

# Integración Oficial con Meta / WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=colmadopos_token_verificacion_seguro
